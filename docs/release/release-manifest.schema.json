{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axion.local/schemas/release-manifest.schema.json",
  "type": "object",
  "required": ["version", "requirements", "image_digests", "migrations", "approvals", "rollback"],
  "properties": {
    "version": { "type": "string" },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "image_digests": { "type": "object", "additionalProperties": { "type": "string" } },
    "migrations": { "type": "array", "items": { "type": "string" } },
    "prompt_model_versions": { "type": "object" },
    "feature_flags": { "type": "object" },
    "approvals": { "type": "array", "items": { "type": "string" } },
    "known_risks": { "type": "array", "items": { "type": "string" } },
    "rollback": { "type": "string" }
  }
}

